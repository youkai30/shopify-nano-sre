+name: Phase 1 Windows CI
+
+on:
+  push:
+    branches: [phase1-reviewed-20261008]
+  pull_request:
+    branches: [nano-sre-recovery-20261007, main, develop]
+
+jobs:
+  windows-test:
+    name: Windows Test Suite & CLI Standalone
+    runs-on: windows-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e ".[dev]"
+          pip install aiohttp
+
+      - name: Install Playwright Chromium
+        run: |
+          python -m playwright install chromium
+
+      - name: Run Pytest Suite on Windows
+        env:
+          PYTHONPATH: src
+          MCP_ENABLED: "false"
+          LLM_PROVIDER: "openai"
+          LLM_API_KEY: ""
+        run: |
+          python -m pytest tests/ -v --tb=short --junitxml=windows-pytest-report.xml
+
+      - name: Run Standalone CLI Audit Cases on Windows
+        shell: powershell
+        env:
+          PYTHONPATH: src
+          MCP_ENABLED: "false"
+          LLM_PROVIDER: "openai"
+          LLM_API_KEY: ""
+        run: |
+          # Case A: Success mode server
+          $procA = Start-Process python -ArgumentList "scripts/local_synthetic_store.py", "success", "9876" -PassThru
+          Start-Sleep -Seconds 2
+          try {
+            python -m nano_sre.cli audit --url http://127.0.0.1:9876/products/item --skill shopify_shopper --output win_case_a_report.json
+          } finally {
+            Stop-Process -Id $procA.Id -ErrorAction SilentlyContinue
+          }
+
+          # Case B: Empty cart drawer mode server
+          $procB = Start-Process python -ArgumentList "scripts/local_synthetic_store.py", "empty", "9877" -PassThru
+          Start-Sleep -Seconds 2
+          try {
+            python -m nano_sre.cli audit --url http://127.0.0.1:9877/products/item --skill shopify_shopper --output win_case_b_report.json
+          } finally {
+            Stop-Process -Id $procB.Id -ErrorAction SilentlyContinue
+          }
+
+      - name: Upload Windows CI Artifacts
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: windows-ci-artifacts
+          path: |
+            windows-pytest-report.xml
+            win_case_a_report.json
+            win_case_b_report.json
+            reports/
